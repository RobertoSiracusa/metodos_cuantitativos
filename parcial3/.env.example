# Credenciales de las APIs de IA para el Parcial III.
# Copiar a .env y completar. El archivo .env NO se versiona.
#
# La carga es en cascada (ver src/utils/config.py::cargar_variables_entorno):
#   1. Variables de entorno del sistema
#   2. parcial3/.env
#   3. metodos_cuantitativos/.env   (raiz del repositorio, compartido)
#   4. .env del directorio de trabajo actual y de su padre
#
# Si no hay ninguna clave, el programa cae al motor experto cuantitativo local
# y aun asi muestra una conclusion y una recomendacion por pantalla.

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (opcional, segundo en la cascada)
OPENAI_API_KEY=

# Servidor local: Ollama en el puerto 11434, o un backend REST propio
LOCAL_API_URL=
